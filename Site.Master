<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="TroikaClothingWeb.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - My ASP.NET Application</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>
    <webopt:BundleReference runat="server" Path="~/Content/css" />
    <link href="<%= ResolveUrl("~/Content/TroikaTheme.css") %>" rel="stylesheet" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Kaushan+Script&display=swap" rel="stylesheet" />

</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

        <%-- <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>--%>


        <%-- ===== Redesigned site header (matches handoff design) ===== --%>
        <header class="th-site-header">

            <%-- Top tier: logo, primary nav, and the dark-mode icon toggle (showcased here as a feature) --%>
            <nav class="navbar navbar-expand-sm navbar-troika th-header-top">
                <div class="container th-header-row">
                    <a class="navbar-brand th-logo" runat="server" href="~/">
                        <img src="/Images/logo-mark.png" alt="Troika Clothing CC" />
                    </a>
                    <ul class="navbar-nav ms-auto th-nav">
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/">HOME</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Public Pages/About">ABOUT US</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Public Pages/Contact">CONTACT</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Public Pages/Products.aspx">SHOP</a></li>
                        <li class="nav-item th-toggle-wrap">
                            <button id="btnThemeToggle" type="button" class="th-theme-toggle" onclick="TroikaTheme.toggle()" aria-label="Switch to dark mode" title="Switch to dark mode">
                                <svg class="th-ico th-ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                                <svg class="th-ico th-ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                                <span class="th-toggle-label th-toggle-label-dark">Dark Mode</span>
                                <span class="th-toggle-label th-toggle-label-light">Light Mode</span>
                            </button>
                        </li>
                    </ul>
                </div>
            </nav>

            <%-- Bottom tier: purple action bar. Keeps .navbar-troika1 so the existing profile-dropdown CSS/JS still applies. --%>
            <nav class="navbar navbar-expand-sm navbar-troika1 th-header-bottom">
                <div class="container">
                    <ul class="navbar-nav ms-auto d-flex flex-row th-actions-list">
                        <!-- When NOT logged in -->
                        <asp:PlaceHolder ID="phLoggedOut" runat="server" Visible="true">
                            <li class="nav-item"><a class="nav-link th-action-link" runat="server" href="~/Public Pages/Cart.aspx"><svg class="th-action-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>Cart (<asp:Label ID="lblCartCount" runat="server" Text="0" />)</a></li>
                            <li class="nav-item"><a class="nav-link th-action-link" runat="server" href="~/Login.aspx"><svg class="th-action-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Account</a></li>
                        </asp:PlaceHolder>
                    <!-- When as a customer logged in -->
                    <asp:PlaceHolder ID="phCustLoggedIn" runat="server" Visible="false">
                        <li class="nav-item">
                            <a class="nav-link th-action-link" runat="server" href="~/Customer Pages/CustomerProfile">Welcome,
                               
                                <asp:Label ID="lblWelcome" runat="server"></asp:Label>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link th-action-link" runat="server" href="~/Public Pages/Cart.aspx"><svg class="th-action-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>Cart (<asp:Label ID="Label2" runat="server" Text="0" />)
                            </a>
                        </li>
                        <li class="nav-item dropdown profile-menu-wrapper">
                            <a class="nav-link th-action-link dropdown-toggle" href="#" id="navbarDropdown" role="button"><svg class="th-action-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Profile
                            </a>

                            <ul id="profileDropdownMenu"
                                class="dropdown-menu dropdown-menu-end mt-2 profile-dropdown-menu"
                                aria-labelledby="navbarDropdown">

                                <li>
                                    <a id="profileManageLink"
                                        class="dropdown-item profile-dropdown-item"
                                        runat="server"
                                        href="~/Customer Pages/CustomerProfile">Manage My Account
                                    </a>
                                </li>

                                <li>
                                    <a id="profileOrdersLink"
                                        class="dropdown-item profile-dropdown-item"
                                        runat="server"
                                        href="~/Customer Pages/SaleHistory">My Orders
                                    </a>
                                </li>

                                <li>
                                    <a id="profileWishlistLink"
                                        class="dropdown-item profile-dropdown-item"
                                        runat="server"
                                        href="~/Customer Pages/Wishlist">My Wishlist
                                    </a>
                                </li>

                                <li>
                                    <hr id="profileDropdownDivider" class="dropdown-divider profile-dropdown-divider" />
                                </li>

                                <li>
                                    <asp:LinkButton ID="btnLogout"
                                        runat="server"
                                        CssClass="dropdown-item profile-dropdown-item profile-dropdown-logout"
                                        OnClick="btnLogout_Click">
                Log Out
                                    </asp:LinkButton>
                                </li>
                            </ul>
                        </li>
                    </asp:PlaceHolder>

                    <!-- When as a admin logged in -->
                    <asp:PlaceHolder ID="phAdmin" runat="server" Visible="false">
                        <li class="nav-item"><a class="nav-link th-action-link" runat="server" href="~/Admin Pages/AdminProfile">Welcome,
                       
                            <asp:Label ID="lblAdmin" runat="server"></asp:Label></a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Admin Pages/ProductManagement">Products</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Admin Pages/Admin">Users</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Admin Pages/Reports">Reports</a></li>
                        <li class="nav-item">
                            <asp:LinkButton ID="LinkButton1" runat="server" CssClass="nav-link" OnClick="btnLogout_Click">Log Out</asp:LinkButton></li>
                    </asp:PlaceHolder>
                </ul>
            </div>
        </nav>
        </header>
        <%--content from other pages go here--%>
        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <%-- Redesigned footer --%>
        <footer class="th-site-footer">
            <div class="th-footer-inner">
                <div class="th-footer-brand">
                    <img src="/Images/logo-mark.png" alt="Troika Clothing C.C." class="th-footer-logo" />
                    <p class="th-footer-blurb">Luxurious everyday essentials &mdash; designed for comfort, warmth and effortless style. Stay warm and stylish.</p>
                    <p class="th-footer-reg">Reg. C.K. 2002 / 058718 / 23</p>
                </div>
                <div class="th-footer-col">
                    <div class="th-footer-h">Shop</div>
                    <ul>
                        <li><a runat="server" href="~/Public Pages/Products.aspx">All Products</a></li>
                        <li><a runat="server" href="~/Public Pages/Cart.aspx">Your Cart</a></li>
                    </ul>
                </div>
                <div class="th-footer-col">
                    <div class="th-footer-h">Company</div>
                    <ul>
                        <li><a runat="server" href="~/Public Pages/About">About Us</a></li>
                        <li><a runat="server" href="~/Public Pages/Contact">Contact</a></li>
                    </ul>
                </div>
                <div class="th-footer-col">
                    <div class="th-footer-h">Account</div>
                    <ul>
                        <li><a runat="server" href="~/Login.aspx">Sign In</a></li>
                        <li><a runat="server" href="~/Register.aspx">Create Account</a></li>
                    </ul>
                </div>
            </div>
            <div class="th-footer-bar">
                <span>&copy; 2025 Troika Clothing C.C. All rights reserved.</span>
                <span class="th-footer-tag">Stay warm and stylish.</span>
            </div>
        </footer>
    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>

    <%--    Botpress Web Chat Integration--%>

    <script src="https://cdn.botpress.cloud/webchat/v3.4/inject.js"></script>
    <script src="https://files.bpcontent.cloud/2025/11/07/14/20251107141451-6UJV4FC6.js" defer></script>


    <script src="<%= ResolveUrl("~/Scripts/theme-toggle.js") %>"></script>

    <%-- Header gains a soft shadow once the page is scrolled (matches handoff) --%>
    <script type="text/javascript">
        (function () {
            var header = document.querySelector(".th-site-header");
            if (!header) return;
            function onScroll() {
                if (window.scrollY > 30) {
                    header.classList.add("th-scrolled");
                } else {
                    header.classList.remove("th-scrolled");
                }
            }
            window.addEventListener("scroll", onScroll, { passive: true });
            onScroll();
        })();
    </script>

    <script type="text/javascript">
        function applyProfileDropdownFix() {
            var isDark = document.body.getAttribute("data-theme") === "dark";

            var menu = document.getElementById("profileDropdownMenu");
            var manage = document.getElementById("profileManageLink");
            var orders = document.getElementById("profileOrdersLink");
            var wishlist = document.getElementById("profileWishlistLink");
            var logout = document.getElementById("<%= btnLogout.ClientID %>");
            var divider = document.getElementById("profileDropdownDivider");

            if (!menu) {
                return;
            }

            if (isDark) {
                menu.style.setProperty("background-color", "#1c1724", "important");
                menu.style.setProperty("border", "1px solid #3b3048", "important");
                menu.style.setProperty("box-shadow", "0 12px 28px rgba(0,0,0,0.55)", "important");

                if (manage) {
                    manage.style.setProperty("color", "#f5f3f7", "important");
                    manage.style.setProperty("background-color", "#1c1724", "important");
                    manage.style.setProperty("font-weight", "700", "important");
                }

                if (orders) {
                    orders.style.setProperty("color", "#f5f3f7", "important");
                    orders.style.setProperty("background-color", "#1c1724", "important");
                    orders.style.setProperty("font-weight", "700", "important");
                }

                if (wishlist) {
                    wishlist.style.setProperty("color", "#f5f3f7", "important");
                    wishlist.style.setProperty("background-color", "#1c1724", "important");
                    wishlist.style.setProperty("font-weight", "700", "important");
                }

                if (logout) {
                    logout.style.setProperty("color", "#ff6b6b", "important");
                    logout.style.setProperty("background-color", "#1c1724", "important");
                    logout.style.setProperty("font-weight", "800", "important");
                }

                if (divider) {
                    divider.style.setProperty("border-top", "1px solid #3b3048", "important");
                }
            } else {
                menu.style.setProperty("background-color", "#ffffff", "important");
                menu.style.setProperty("border", "1px solid #d8c8f0", "important");
                menu.style.setProperty("box-shadow", "0 12px 28px rgba(0,0,0,0.18)", "important");

                if (manage) {
                    manage.style.setProperty("color", "#1f1f1f", "important");
                    manage.style.setProperty("background-color", "#ffffff", "important");
                    manage.style.setProperty("font-weight", "700", "important");
                }

                if (orders) {
                    orders.style.setProperty("color", "#1f1f1f", "important");
                    orders.style.setProperty("background-color", "#ffffff", "important");
                    orders.style.setProperty("font-weight", "700", "important");
                }

                if (wishlist) {
                    wishlist.style.setProperty("color", "#1f1f1f", "important");
                    wishlist.style.setProperty("background-color", "#ffffff", "important");
                    wishlist.style.setProperty("font-weight", "700", "important");
                }

                if (logout) {
                    logout.style.setProperty("color", "#b00020", "important");
                    logout.style.setProperty("background-color", "#ffffff", "important");
                    logout.style.setProperty("font-weight", "800", "important");
                }

                if (divider) {
                    divider.style.setProperty("border-top", "1px solid #e5e7eb", "important");
                }
            }
        }

        function attachProfileDropdownHoverFix() {
            var isDark = document.body.getAttribute("data-theme") === "dark";

            var manage = document.getElementById("profileManageLink");
            var orders = document.getElementById("profileOrdersLink");
            var wishlist = document.getElementById("profileWishlistLink");
            var logout = document.getElementById("<%= btnLogout.ClientID %>");

            var normalItems = [manage, orders, wishlist];

            normalItems.forEach(function (item) {
                if (!item) {
                    return;
                }

                item.onmouseenter = function () {
                    item.style.setProperty("background-color", isDark ? "#d9c8f0" : "#644F7D", "important");
                    item.style.setProperty("color", isDark ? "#121018" : "#ffffff", "important");
                };

                item.onmouseleave = function () {
                    var currentlyDark = document.body.getAttribute("data-theme") === "dark";
                    item.style.setProperty("background-color", currentlyDark ? "#1c1724" : "#ffffff", "important");
                    item.style.setProperty("color", currentlyDark ? "#f5f3f7" : "#1f1f1f", "important");
                };
            });

            if (logout) {
                logout.onmouseenter = function () {
                    logout.style.setProperty("background-color", "#b00020", "important");
                    logout.style.setProperty("color", "#ffffff", "important");
                };

                logout.onmouseleave = function () {
                    var currentlyDark = document.body.getAttribute("data-theme") === "dark";
                    logout.style.setProperty("background-color", currentlyDark ? "#1c1724" : "#ffffff", "important");
                    logout.style.setProperty("color", currentlyDark ? "#ff6b6b" : "#b00020", "important");
                };
            }
        }

        function initialiseProfileDropdownFix() {
            applyProfileDropdownFix();
            attachProfileDropdownHoverFix();
        }

        document.addEventListener("DOMContentLoaded", initialiseProfileDropdownFix);
        window.addEventListener("load", initialiseProfileDropdownFix);

        var themeObserver = new MutationObserver(function () {
            initialiseProfileDropdownFix();
        });

        document.addEventListener("DOMContentLoaded", function () {
            themeObserver.observe(document.body, {
                attributes: true,
                attributeFilter: ["data-theme"]
            });
        });

        setTimeout(initialiseProfileDropdownFix, 100);
        setTimeout(initialiseProfileDropdownFix, 500);
</script>

</body>
</html>
