<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for secrets.config. Copy this file to secrets.config in the same
  folder and fill in the real values; secrets.config is git-ignored.

  Web.config declares appSettings file="secrets.config", so ASP.NET merges these
  keys in at runtime and they override the empty placeholders in Web.config.

  GmailClientId / GmailClientSecret / GmailRefreshToken
      Google Cloud OAuth2 credentials for the Gmail API, used to send order
      receipts over HTTPS rather than SMTP. Create an OAuth client in the Google
      Cloud console, authorise it against the sender mailbox once, and keep the
      resulting refresh token here.

  GmailSenderEmail
      The Gmail address the receipts are sent from.

  GoogleMapsApiKey
      Google Maps JavaScript API key for the delivery-address autocomplete on the
      Register, Customer Profile and Cart forms. This key reaches the browser, so
      restrict it by HTTP referrer in the Google Cloud console.
-->
<appSettings>
  <add key="GmailClientId" value="" />
  <add key="GmailClientSecret" value="" />
  <add key="GmailRefreshToken" value="" />
  <add key="GmailSenderEmail" value="" />
  <add key="GoogleMapsApiKey" value="" />
</appSettings>
